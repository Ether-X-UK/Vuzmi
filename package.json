{
  "name": "vuzmi",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "scripts": {
    "dev": "npm run services:start && concurrently --kill-others -n api,worker,web -c cyan,yellow,green \"npm:dev:api\" \"npm:dev:worker\" \"npm:dev:web\"",
    "dev:simulation": "VUZMI_SIMULATION_ONLY=1 VUZMI_DEV_NO_AUTH=1 concurrently --kill-others -n api,web -c cyan,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace @vuzmi/api",
    "dev:web": "npm run dev --workspace @vuzmi/web",
    "dev:worker": "npm run dev --workspace @vuzmi/worker",
    "services:start": "node scripts/dev-services.mjs start",
    "services:stop": "node scripts/dev-services.mjs stop",
    "typecheck": "tsc --noEmit && npm run typecheck --workspace @vuzmi/mobile",
    "test": "node --import tsx --test packages/core/test/*.test.ts packages/providers/test/*.test.ts apps/api/test/*.test.ts apps/mobile/test/*.test.ts apps/web/test/*.test.ts",
    "export:ios": "npm run export:ios --workspace @vuzmi/mobile",
    "dev:ios": "EXPO_NO_TELEMETRY=1 npm run ios --workspace @vuzmi/mobile",
    "test:postgres": "node scripts/test-postgres.mjs",
    "build": "npm run build --workspace @vuzmi/web",
    "check": "npm run typecheck && npm test && npm run build",
    "start": "node scripts/start-local.mjs",
    "backup:local": "node scripts/backup.mjs",
    "restore:local": "node scripts/restore.mjs",
    "test:recovery": "node --import tsx scripts/test-recovery.mjs",
    "setup:development": "node --import tsx scripts/setup-development.mjs",
    "test:development-runner": "node --import tsx --test packages/runtime/test/development-runner.integration.ts",
    "package:source": "node scripts/package-source.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "glob": "14.0.2",
    "minimatch": "11.0.1"
  }
}
