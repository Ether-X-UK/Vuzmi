{
  "name": "vuzmi",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "engines": { "node": ">=22.12.0 <23" },
  "scripts": {
    "dev": "concurrently --kill-others -n api,web -c cyan,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace @vuzmi/api",
    "dev:web": "npm run dev --workspace @vuzmi/web",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test packages/core/test/*.test.ts apps/api/test/*.test.ts",
    "build": "npm run build --workspace @vuzmi/web",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
