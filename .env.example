# Server-only local configuration. No paid provider keys are used.
PORT=4310
OLLAMA_BASE_URL=http://127.0.0.1:11435
OLLAMA_MODEL=qwen3.5:4b
# Local helper creates DATABASE_URL in ignored .data/dev/database.env.
# DATABASE_URL=postgresql://vuzmi:replace-with-local-password@127.0.0.1:55432/vuzmi
# VUZMI_SIMULATION_ONLY=1
# VUZMI_DATA_DIR=/absolute/path/to/private/local/state
OLLAMA_EMBEDDING_MODEL=embeddinggemma:300m
# npm start serves the built web client with the API on loopback4310.
# VUZMI_PUBLIC_URL=http://127.0.0.1:4310
# Generated private files supply these locally. Set secure server-only values for other installs.
# BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# VUZMI_OWNER_SETUP_KEY=replace-with-at-least-32-random-characters
# Explicit loopback development only; npm start refuses this bypass.
# VUZMI_DEV_NO_AUTH=1
